<Window x:Class="LoopPlayer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoopPlayer — повтор фрагмента A–B"
        Width="820" Height="360" MinWidth="640" MinHeight="330"
        WindowStartupLocation="CenterScreen"
        FontSize="14">

    <Window.Resources>
        <!-- Ни один элемент не получает фокус: Space и стрелки всегда достаются плееру. -->
        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
        <Style x:Key="TimeLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PointButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Выбор трека и скорость -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Grid.Column="0" Content="Выбрать трек" Click="OpenButton_Click"
                    ToolTip="Открыть аудиофайл (Ctrl+O)"/>
            <TextBlock x:Name="FileNameText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="Трек не выбран" Foreground="Gray"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Скорость:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="SpeedDownButton" Content="−" Click="SpeedDownButton_Click"
                        ToolTip="Медленнее на 0,025"/>
                <TextBlock x:Name="SpeedText" Style="{StaticResource TimeLabel}" MinWidth="64" Text="×1,000"/>
                <Button x:Name="SpeedUpButton" Content="+" Click="SpeedUpButton_Click"
                        ToolTip="Быстрее на 0,025"/>
            </StackPanel>
        </Grid>

        <!-- Шкала (0) -->
        <Grid Grid.Row="1" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionText" Grid.Column="0" Style="{StaticResource TimeLabel}" Text="00:00"/>
            <Slider x:Name="MainSlider" Grid.Column="1" Minimum="0" Maximum="1" Height="28"
                    ToolTip="Текущая позиция — перетащите бегунок"/>
            <TextBlock x:Name="DurationText" Grid.Column="2" Style="{StaticResource TimeLabel}" Text="00:00"/>
        </Grid>

        <!-- Точка A -->
        <Grid Grid.Row="2" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SetAButton" Grid.Column="0" Content="A" Style="{StaticResource PointButton}"
                    Click="SetAButton_Click" ToolTip="Установить A = текущая позиция (A)"/>
            <TextBlock x:Name="ATimeText" Grid.Column="1" Style="{StaticResource TimeLabel}" Text="00:00"/>
            <Button x:Name="AMinus1Button" Grid.Column="2" Content="−1" Click="AMinus1Button_Click" ToolTip="A назад на 1 сек"/>
            <Button x:Name="AMinusSmallButton" Grid.Column="3" Content="−0,2" Click="AMinusSmallButton_Click" ToolTip="A назад на 0,2 сек"/>
            <Slider x:Name="ASlider" Grid.Column="4" Minimum="0" Maximum="1" ToolTip="Положение точки A"/>
            <Button x:Name="APlusSmallButton" Grid.Column="5" Content="+0,2" Click="APlusSmallButton_Click" ToolTip="A вперёд на 0,2 сек"/>
            <Button x:Name="APlus1Button" Grid.Column="6" Content="+1" Click="APlus1Button_Click" ToolTip="A вперёд на 1 сек"/>
        </Grid>

        <!-- Точка B -->
        <Grid Grid.Row="3" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SetBButton" Grid.Column="0" Content="B" Style="{StaticResource PointButton}"
                    Click="SetBButton_Click" ToolTip="Установить B = текущая позиция (B)"/>
            <TextBlock x:Name="BTimeText" Grid.Column="1" Style="{StaticResource TimeLabel}" Text="00:00"/>
            <Button x:Name="BMinus1Button" Grid.Column="2" Content="−1" Click="BMinus1Button_Click" ToolTip="B назад на 1 сек"/>
            <Button x:Name="BMinusSmallButton" Grid.Column="3" Content="−0,2" Click="BMinusSmallButton_Click" ToolTip="B назад на 0,2 сек"/>
            <Slider x:Name="BSlider" Grid.Column="4" Minimum="0" Maximum="1" ToolTip="Положение точки B"/>
            <Button x:Name="BPlusSmallButton" Grid.Column="5" Content="+0,2" Click="BPlusSmallButton_Click" ToolTip="B вперёд на 0,2 сек"/>
            <Button x:Name="BPlus1Button" Grid.Column="6" Content="+1" Click="BPlus1Button_Click" ToolTip="B вперёд на 1 сек"/>
        </Grid>

        <!-- Счётчик -->
        <TextBlock x:Name="RepeatText" Grid.Row="4" Margin="0,8,0,0" FontSize="16" Text="Повторений: 0"/>

        <!-- Статус / ошибки -->
        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                   VerticalAlignment="Top" Text=""/>

        <!-- Основная панель управления -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="Back2Button" Content="−2 сек" Click="Back2Button_Click" ToolTip="Назад 2 сек (←)"/>
            <Button x:Name="PlayPauseButton" Content="▶" MinWidth="70" FontSize="18" Click="PlayPauseButton_Click"
                    ToolTip="Play / Pause (Space)"/>
            <Button x:Name="GoToAButton" Content="Перейти к A" Click="GoToAButton_Click" ToolTip="Перейти к A (Ctrl+Shift+A)"/>
            <Button x:Name="Forward2Button" Content="+2 сек" Click="Forward2Button_Click" ToolTip="Вперёд 2 сек (→)"/>
        </StackPanel>
    </Grid>
</Window>
